# --- WhatsApp Cloud API (official Meta API - free tier, no 3rd party SaaS) ---
# From developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v20.0

# Any string you choose - must match what you enter in the Meta webhook config
WEBHOOK_VERIFY_TOKEN=choose_a_random_secret_string

# --- AI (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_SYSTEM_PROMPT=You are a helpful, friendly assistant for our business on WhatsApp. Keep replies short and clear.

# Toggle AI auto-reply on/off globally (true/false)
AI_ENABLED=true

# --- Broadcast ---
# Milliseconds to wait between each broadcast message to avoid hitting rate limits
BROADCAST_DELAY_MS=1200

# --- Server / Dashboard ---
PORT=3000
# Simple shared-secret login for the dashboard (not for the WhatsApp webhook)
DASHBOARD_PASSWORD=change_me

# Path to the SQLite database file
DB_PATH=./data/app.db
